# Copy this file to .env. Enter the key locally. Do not send it in chat.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_MEMORY_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536
# Use a local database password. Keep the real value outside version control.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://memory:YOUR_LOCAL_PASSWORD@127.0.0.1:54329/memory_demo
TEST_DATABASE_URL=postgresql://memory:YOUR_LOCAL_PASSWORD@127.0.0.1:54329/memory_test
MEMORY_LLM_SYNC_STRATEGY=interval
MEMORY_LLM_EVERY_N_HUMANS=5
MEMORY_LLM_MIN_CONV_CHARS=20
MEMORY_LLM_FAREWELL_TRIGGERS=goodbye,that's all for now,talk later,see you,catch you later
MEMORY_PROFILE_MAX_TOKENS=2400
# Optional: 64 hexadecimal characters, decoded to a 32-byte AES key.
LANGGRAPH_AES_KEY=
